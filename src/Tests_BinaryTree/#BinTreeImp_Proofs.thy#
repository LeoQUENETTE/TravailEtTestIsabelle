lemma search_step_l:
  assumes
    "<btree_assn l lp>
       search\<^sub>i lp x
     <\<lambda>res. \<up>(res = search l x)>"
  shows
    "<p \<mapsto>\<^sub>r Btnode v lp rp * btree_assn l lp * btree_assn r rp>
       search\<^sub>i lp x
     <\<lambda>res.
        p \<mapsto>\<^sub>r Btnode v lp rp *
        btree_assn l lp *
        btree_assn r rp *
        \<up>(res = search l x)>"
proof -
  have emp_case: "<p \<mapsto>\<^sub>r Btnode v lp None  * btree_assn l lp>
      search\<^sub>i lp x
   <\<lambda>res. p \<mapsto>\<^sub>r Btnode v lp None  * \<up>(res = search l x)>"
    by (rule frame_rule_left[OF assms])
  have
  "<p \<mapsto>\<^sub>r Btnode v lp rp * btree_assn r rp * btree_assn l lp>
      search\<^sub>i lp x
   <\<lambda>res. p \<mapsto>\<^sub>r Btnode v lp rp * btree_assn r rp * \<up>(res = search l x)>"
  by (rule frame_rule_left[OF assms])
  then show ?thesis
    using assms emp_case
    apply (cases r; cases rp; sep_auto; simp add : emp_case)
    oops
lemma search_equiv : "
  <btree_assn t p> search\<^sub>i p x <\<lambda>r. btree_assn t p * \<up>(r = search t x)>"
proof (induction t x arbitrary: x rule: search.induct)
  case (1 x)
  show ?case
    using btree_assn.simps
    by (cases p; subst search\<^sub>i.simps; sep_auto)
next
  case Node_h: (2 v l r x)
  then show ?case 
  proof (cases p)
    case None
    then show ?thesis 
      by (subst search\<^sub>i.simps; sep_auto)
  next
    case (Some q)
    consider "x = v"|"x < v"|"x > v" by fastforce
    then show ?thesis 
    proof (cases)
      case 1
      then show ?thesis 
        by (subst search\<^sub>i.simps; sep_auto)
    next
      case 2
      then show ?thesis 
      proof (cases l)
        case Leaf
        have "<btree_assn (bin_tree.Node v .. r) (Some q)> search\<^sub>i (Some q) x 
        <\<lambda>ra. btree_assn (bin_tree.Node v .. r) (Some q) *  \<up> (ra = undefined)>"
          using 2 Node_h search\<^sub>i.simps btree_assn.simps 
          
          sorry
        have "<btree_assn (bin_tree.Node v .. r) p>
        search\<^sub>i p x
        <\<lambda>ra. btree_assn (bin_tree.Node v .. r) p *  \<up> (ra = search (bin_tree.Node v .. r) x)> \<Longrightarrow>
        <btree_assn (bin_tree.Node v .. r) p> 
        search\<^sub>i p x
        <\<lambda>ra. btree_assn (bin_tree.Node v .. r) p *  \<up> (ra = undefined)>"
          using 2 Node_h search.simps
          by (metis (full_types) not_less_iff_gr_or_eq search.simps(1,2))
        then show ?thesis
          sorry
      next
        case (Node x21 x22 x23)
        then show ?thesis sorry
      qed
        
    next
      case 3
      then show ?thesis 
        sorry
    qed
  qed
qed

lemma search_max_equiv: "
  <btree_assn t p> search_max\<^sub>i p <\<lambda>r. btree_assn t p * \<up>(r = search_max t)>"
proof (induction t rule : search_max.induct)
  case 1
  then show ?case 
  by (subst search_max\<^sub>i.simps;cases p; sep_auto) 
next
  case (2 v l)
  have "<btree_assn (bin_tree.Node v l ..) p>
          search_max\<^sub>i p 
        <\<lambda>res. btree_assn (bin_tree.Node v l ..) p * \<up>(res = v)>"
    apply (subst search_max\<^sub>i.simps)
    proof (cases p; sep_auto)
      show "\<And>a lp.
       p = Some a \<Longrightarrow>
       a \<mapsto>\<^sub>r Btnode v lp None *
       btree_assn l lp \<Longrightarrow>\<^sub>A
       a \<mapsto>\<^sub>r
       Btnode v lp
        None *
       btree_assn l lp *
       btree_assn .. None" 
        by sep_auto 
    next
      show "\<And>a lp rp x.
       p = Some a \<Longrightarrow>
       rp = Some x \<Longrightarrow>
       <a \<mapsto>\<^sub>r Btnode v lp rp *
        btree_assn l lp *
        btree_assn .. rp>
       search_max\<^sub>i rp
       <\<lambda>res. \<exists>\<^sub>Alp rp.
                  a \<mapsto>\<^sub>r
                  Btnode v lp rp *
                  btree_assn l lp *
                  btree_assn .. rp *
                  \<up> (res = v)>"
        using btree_assn.simps by simp
    qed
  then show ?case
    by simp
next
  case (3 v l vr lr rr)
  have "\<And>x xa lp rpa lpa. 
    <x \<mapsto>\<^sub>r Btnode v lp (Some xa) *
        btree_assn l lp * 
        xa \<mapsto>\<^sub>r Btnode vr lpa rpa *
          btree_assn lr lpa *
          btree_assn rr rpa>
      search_max\<^sub>i (Some xa) 
    <\<lambda>res. \<up>(res = search_max (bin_tree.Node vr lr rr))>"
    sorry
  then show ?case 
    apply (cases p; sep_auto)
    sorry
qed



