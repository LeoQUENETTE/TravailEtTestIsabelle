lemma btree_assn_decomp1 : 
  assumes "lp = None"
  assumes "rp = None"
  shows "p \<mapsto>\<^sub>r Btnode x None None \<Longrightarrow>\<^sub>A
          p \<mapsto>\<^sub>r Btnode x lp rp * btree_assn .. lp *
          btree_assn .. rp"
  using assms
  by (cases lp; cases rp; sep_auto)

lemma none_equiv :
shows "<emp> 
  return None 
  <\<lambda>r. btree_assn Leaf r>"
  unfolding hoare_triple_def snga_assn_def one_assn_def
  apply (auto
    elim!: run_elims
    simp: relH_def in_range.simps mod_emp Abs_assn_inverse
  )
