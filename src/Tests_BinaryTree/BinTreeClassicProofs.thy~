(* ----------------------- delete ----------------------- *)
subsection delete

lemma delete_subset_core:
  assumes "bst_invariant (Node v l r)"
  shows "to_set (delete (Node v l r) x) \<subseteq> to_set (Node v l r)"
  using assms search_max_subset search_max_work
proof (cases "v = x")
  case h : True
  then show ?thesis
    proof (induction l rule : to_set.induct)
      case 1
      then show ?case 
        by auto
    next
      case (2 vl ll rl)
      then show ?case 
      proof (induction r rule : to_set.induct)
        case 1
        then show ?case by auto
      next
        case (2 vr lr rr)
        then have "to_set (delete r x) \<subseteq> to_set (Node v l r)" 
          apply auto (*xa \<in> to_set (delete r x) \<Longrightarrow> xa \<noteq> x \<Longrightarrow> xa \<notin> to_set r \<Longrightarrow> False*)
          sorry
        then show ?case 
          
          sorry
      qed
    qed
next
  case False
  then show ?thesis sorry
qed

lemma delete_subset_core: 
  assumes "bst_invariant t"
  shows "to_set (delete t x) \<subseteq> to_set t"
  using assms
proof (induct t arbitrary: x)
  case Leaf
  then show ?case by simp
next
  case h10 : (Node v l r)
  then show ?case
  proof (cases "v = x")
    case True
    then show ?thesis
    proof (cases l)
      case Leaf
      then show ?thesis 
        by auto
    next
      case h11 :(Node vl ll rl)
      then show ?thesis 
      proof(cases r)
        case Leaf
        then show ?thesis 
          using h10 h11 by auto
      next
        case h12 : (Node vr lr rr)
        have "to_set (delete l (search_max l)) \<subseteq> to_set l" 
          using h10.hyps(1) h10.prems by auto
        have "Node (search_max l) (delete l (search_max l)) r = delete t x" using h10 h11 h12 True assms 
          apply simp
          nitpick
          sorry
        have "to_set (delete t x) = to_set (delete l (search_max l)) \<union> to_set(r) \<union> {search_max l}" 
          using h10 h11 h12 
          nitpick
        then show ?thesis 
          using search_max_subset
          
          sorry
      qed
        sorry
    qed
      
  next
    case False
    then show ?thesis
    proof (cases "v > x")
      case True
      then have eq: "delete (Node v l r) x = Node v (delete l x) r"
        using \<open>v \<noteq> x\<close> by simp
      then show ?thesis
        using Node.hyps(1)
        using assms(1,2) by fastforce
    next
      case False
      then have eq: "delete (Node v l r) x = Node v l (delete r x)"
        using \<open>v \<noteq> x\<close> by simp
      then show ?thesis
        using Node.hyps(2) assms
        by (simp add: eq , blast)
    qed
  qed
qed

lemma delete_subset_r:
  shows "to_set (Node v l (delete r x)) \<subseteq> to_set (Node v l r)"
  using delete_subset_core[of r x]
  by (smt (verit) Un_iff bin_tree.discI bin_tree.inject delete.simps(1) subsetI subset_Un_eq
      to_set.elims)

lemma delete_subset_l:
  shows "to_set (Node v (delete l x) r) \<subseteq> to_set (Node v l r)"
  using delete_subset_core[of l x]
  by (smt (verit, ccfv_threshold) Un_iff subset_iff to_set_decomp2 to_set_include to_set_include_l
      to_set_include_r)

lemma
  assumes "x\<in>to_set t"
  assumes "finite (to_set t)"
  assumes "bst_invariant t"
  shows "x \<notin> to_set (delete t x)"
  using assms
proof (induction t)
  case Leaf
  then show ?case 
    by auto
next
  case (Node v l r)
  consider "v=x"|"v<x"|"v>x" 
    by (metis linorder_less_linear)
  then show ?case 
  proof (cases)
    case 1
    then show ?thesis 
      apply (subst delete.simps ; auto) 
      sorry
  next
    case 2
    then show ?thesis 
      using assms
      apply (subst delete.simps ; auto)
      sorry
  next
    case 3
    then show ?thesis 
      using assms
      apply (subst delete.simps ; auto)
      sorry
  qed
qed


