fun btree_assn :: "('a::heap) bin_tree \<Rightarrow> 'a ibtree \<Rightarrow> assn" where
  "btree_assn Leaf None = emp" |
  "btree_assn Leaf (Some _) = false" |
  "btree_assn (BinTreeClassic.Node x l r) None = false" |
  "btree_assn (BinTreeClassic.Node x l r) (Some p) =
     (\<exists>\<^sub>A lp rp.
        p \<mapsto>\<^sub>r Btnode x lp rp
      * btree_assn l lp
      * btree_assn r rp)"

