partial_function (heap) isin\<^sub>i :: "'a::{heap, linorder} btnode ref \<Rightarrow> 'a \<Rightarrow> bool Heap" where 
"isin\<^sub>i p x = do {
  node \<leftarrow> !p;
  (case node of
     Btnode v lp rp \<Rightarrow> 
       if v = x then return True
       else if x < v then 
         (case lp of
            None    => return False
          | Some lp' => isin\<^sub>i lp' x)
       else 
         (case rp of
            None    => return False
          | Some rp' => isin\<^sub>i rp' x)
  )
}"
