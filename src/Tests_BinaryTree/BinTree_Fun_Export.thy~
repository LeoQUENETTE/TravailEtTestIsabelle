partial_function (heap) insert\<^sub>_list\<^sub>i :: "'a::{heap, linorder} btnode ref option \<Rightarrow> 'a list \<Rightarrow> 'a btnode ref option Heap" where 
"insert\<^sub>_list\<^sub>i o' l = (case l of
  [] \<Rightarrow> return o' |
  x#xs \<Rightarrow> do {
    (case o' of 
      None \<Rightarrow> return insert_list\<^sub>i (Some (Btnode x None None)) xs|
      (Some p) \<Rightarrow> do {
        case p of (Btnode v lp rp) \<Rightarrow>
          if x = v then return insert_list\<^sub>i o' xs 
          else if x < v then return insert_list\<^sub>i lp (x)
      }
    )
  }
)"

partial_function (heap) insert\<^sub>_list\<^sub>i :: "'a::{heap, linorder} btnode ref option \<Rightarrow> 'a list \<Rightarrow> 'a btnode ref option Heap" where 
"insert\<^sub>_list\<^sub>i o' l = (case o' of
  None \<Rightarrow> do {
    (case l of 
    [] \<Rightarrow> None |
    x#xs \<Rightarrow> insert_list\<^sub>i (Some (Btnode x None None)) xs
    )
  }|
  (Some p) \<Rightarrow> do { 
    (case p of (Btnode v lp rp) \<Rightarrow>
      do {
        case l of 
          [] \<Rightarrow> None|
          x#xs \<Rightarrow> do {
            (
              if x=v then insert_list\<^sub>i (Some p) xs 
              else if x<v then insert_list\<^sub>i lp (x#xs)
              else insert_list\<^sub>i rp (x#xs)
            )
          }
      }  
    )
  }
)"


