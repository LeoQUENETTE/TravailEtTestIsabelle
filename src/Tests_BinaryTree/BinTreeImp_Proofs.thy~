lemma to_set_equiv : "
  <btree_assn t p>
  to_set\<^sub>i p
  <\<lambda>r. btree_assn t p *  \<up>(r = to_set t)>"
proof (induction t arbitrary: p)
  case Leaf
  then show ?case
    apply (subst to_set\<^sub>i.simps)
    using btree_assn.simps
    by (cases p; sep_auto)
next
  case (Node v l r)
  then show ?case 
    using btree_assn.simps
    by (subst to_set\<^sub>i.simps)
     (sep_auto 
      heap: Node.IH(1) Node.IH(2))
qed

