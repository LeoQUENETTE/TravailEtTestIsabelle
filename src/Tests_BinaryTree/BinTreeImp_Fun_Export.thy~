partial_function (heap) insert\<^sub>i :: "'a::{heap, linorder} btnode ref option \<Rightarrow> 'a \<Rightarrow> 'a btnode ref option Heap" where 
"insert\<^sub>i o' x = (case o' of 
  None \<Rightarrow> do {
    p \<leftarrow> ref (Btnode x None None); 
    return (Some p)
  }|
  (Some p) \<Rightarrow> do {
    node \<leftarrow> !p; 
    (case node of 
      (Btnode v lp rp) \<Rightarrow> do {
        if x = v then return (Some p)
        else if x < v then do {
          lp' \<leftarrow> insert\<^sub>i lp x;
          p := Btnode v lp' rp;
          return (Some p)
        }
        else do {
          rp' \<leftarrow> insert\<^sub>i rp x;
          p := Btnode v lp rp';
          return (Some p)
        } 
      }
    )
  } 
)"

